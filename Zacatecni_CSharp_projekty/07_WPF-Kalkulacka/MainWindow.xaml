<Window x:Class="_07_WPF_Kalkulacka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_07_WPF_Kalkulacka"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="425">
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="Display" Grid.Row="0"
                 Margin="10"
                 FontSize="40"
                 TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 IsReadOnly="True"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="←x" Margin="5" FontSize="30" Click="Backspace"/>
            <Button Grid.Row="0" Grid.Column="1" Content="C" Margin="5" FontSize="30" Click="Delete"/>
            <Button Grid.Row="0" Grid.Column="2" Content="x²" Margin="5" FontSize="30" Click="naDruhou"/>
            <Button Grid.Row="0" Grid.Column="3" Content="/" Margin="5" FontSize="30" Click="Deleno"/>

            <Button Grid.Row="1" Grid.Column="0" Content="7" Margin="5" FontSize="30" Click="Cislice"/>
            <Button Grid.Row="1" Grid.Column="1" Content="8" Margin="5" FontSize="30" Click="Cislice"/>
            <Button Grid.Row="1" Grid.Column="2" Content="9" Margin="5" FontSize="30" Click="Cislice"/>
            <Button Grid.Row="1" Grid.Column="3" Content="*" Margin="5" FontSize="30" Click="Krat"/>

            <Button Grid.Row="2" Grid.Column="0" Content="4" Margin="5" FontSize="30" Click="Cislice"/>
            <Button Grid.Row="2" Grid.Column="1" Content="5" Margin="5" FontSize="30" Click="Cislice"/>
            <Button Grid.Row="2" Grid.Column="2" Content="6" Margin="5" FontSize="30" Click="Cislice"/>
            <Button Grid.Row="2" Grid.Column="3" Content="-" Margin="5" FontSize="30" Click="Minus"/>

            <Button Grid.Row="3" Grid.Column="0" Content="1" Margin="5" FontSize="30" Click="Cislice"/>
            <Button Grid.Row="3" Grid.Column="1" Content="2" Margin="5" FontSize="30" Click="Cislice"/>
            <Button Grid.Row="3" Grid.Column="2" Content="3" Margin="5" FontSize="30" Click="Cislice"/>
            <Button Grid.Row="3" Grid.Column="3" Content="+" Margin="5" FontSize="30" Click="Plus"/>

            <Button Grid.Row="4" Grid.Column="0" Content="+/-" Margin="5" FontSize="30" Click="Negace"/>
            <Button Grid.Row="4" Grid.Column="1" Content="0" Margin="5" FontSize="30" Click="Cislice"/>
            <Button Grid.Row="4" Grid.Column="2" Content="," Margin="5" FontSize="30" Click="desetinnaCarka"/>
            <Button Grid.Row="4" Grid.Column="3" Content="=" Margin="5" FontSize="30" Click="rovnaSe"/>
        </Grid>
    </Grid>
</Window>
